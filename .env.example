# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.
# data.go.kr service key (either the Encoding or the Decoding key works). Never commit the real value.
DATA_GO_KR_KEY=

# AI 분석 (/api/analyze) — OpenAI Responses API. Server-side only; never exposed to the browser.
OPENAI_API_KEY=
# Model name (default gpt-6-luna)
OPENAI_MODEL=gpt-6-luna

# Usage log (/api/log → Airtable UsageLogs). Server-side only. Without these, logging is silently skipped.
AIRTABLE_TOKEN=
BASE_ID=
TABLE=UsageLogs
